# https://editorconfig.org -- most editors read this by themselves (some through
# a plugin) and then agree on the basics, whoever is typing.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,cff}]
indent_size = 2

[*.py]
# The width CI's flake8 step uses (the GitHub editor's width).
max_line_length = 127

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Jupyter writes notebooks with a one-space indent.
[*.ipynb]
indent_size = 1

# Written and regenerated by versioneer: keep them as generated.
[{versioneer.py,src/galaxia_ananke/_version.py}]
trim_trailing_whitespace = unset
insert_final_newline = unset
max_line_length = unset
